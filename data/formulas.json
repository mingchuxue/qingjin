{
  "math": {
    "name": "数学",
    "sections": [
      {
        "title": "代数与函数",
        "items": [
          {
            "name": "韦达定理",
            "formula": "$x_1+x_2=-\\dfrac{b}{a},\\;x_1x_2=\\dfrac{c}{a}$",
            "note": "对 $ax^2+bx+c=0\\,(a\\ne 0)$。"
          },
          {
            "name": "基本不等式",
            "formula": "$\\dfrac{a+b}{2}\\ge\\sqrt{ab}\\quad(a,b>0)$",
            "note": "等号当且仅当 $a=b$。"
          },
          {
            "name": "对数换底",
            "formula": "$\\log_a b=\\dfrac{\\ln b}{\\ln a}=\\dfrac{1}{\\log_b a}$",
            "note": "$a>0,a\\ne1,b>0$；写成倒数 $1/\\log_b a$ 还要求 $b\\ne1$。"
          },
          {
            "name": "指数与对数互化",
            "formula": "$a^{\\log_a x}=x,\\quad\\log_a(a^x)=x$",
            "note": "$a>0,a\\ne1$；$a^{\\log_a x}=x$ 要求 $x>0$。"
          },
          {
            "name": "辅助角",
            "formula": "$a\\sin x+b\\cos x=\\sqrt{a^2+b^2}\\sin(x+\\varphi)$",
            "note": "$R=\\sqrt{a^2+b^2}>0$，取 $\\cos\\varphi=a/R,\\sin\\varphi=b/R$，不能只用 $\\tan\\varphi=b/a$ 决定象限。"
          }
        ]
      },
      {
        "title": "三角与解三角形",
        "items": [
          {
            "name": "正弦定理",
            "formula": "$\\dfrac{a}{\\sin A}=\\dfrac{b}{\\sin B}=\\dfrac{c}{\\sin C}=2R$"
          },
          {
            "name": "余弦定理",
            "formula": "$c^2=a^2+b^2-2ab\\cos C$"
          },
          {
            "name": "面积",
            "formula": "$S=\\dfrac{1}{2}ab\\sin C$"
          },
          {
            "name": "倍角",
            "formula": "$\\sin 2x=2\\sin x\\cos x,\\;\\cos 2x=2\\cos^2 x-1=1-2\\sin^2 x$"
          },
          {
            "name": "周期",
            "formula": "$y=A\\sin(\\omega x+\\varphi)$ 的周期 $T=\\dfrac{2\\pi}{|\\omega|}$",
            "note": "$A\\ne0,\\omega\\ne0$，此式为最小正周期；常值函数无最小正周期。"
          }
        ]
      },
      {
        "title": "解析几何",
        "items": [
          {
            "name": "点到直线",
            "formula": "$d=\\dfrac{|ax_0+by_0+c|}{\\sqrt{a^2+b^2}}$",
            "note": "直线 $ax+by+c=0$，要求 $a^2+b^2>0$。"
          },
          {
            "name": "椭圆",
            "formula": "$\\dfrac{x^2}{a^2}+\\dfrac{y^2}{b^2}=1\\;(a>b>0),\\;c^2=a^2-b^2,\\;e=\\dfrac{c}{a}$"
          },
          {
            "name": "双曲线",
            "formula": "$\\dfrac{x^2}{a^2}-\\dfrac{y^2}{b^2}=1,\\;c^2=a^2+b^2,\\;e=\\dfrac{c}{a}>1$",
            "note": "渐近线 $y=\\pm\\dfrac{b}{a}x$。"
          },
          {
            "name": "抛物线（人教 A 版）",
            "formula": "$y^2=2px\\;(p>0)$，焦点 $\\left(\\dfrac{p}{2},0\\right)$，准线 $x=-\\dfrac{p}{2}$",
            "note": "通径长 $2p$。"
          },
          {
            "name": "弦长",
            "formula": "$\\ell=\\sqrt{1+k^2}\\sqrt{(x_1+x_2)^2-4x_1x_2}$"
          }
        ]
      },
      {
        "title": "数列与导数",
        "items": [
          {
            "name": "等差通项与求和",
            "formula": "$a_n=a_1+(n-1)d,\\;S_n=\\dfrac{n}{2}(a_1+a_n)$"
          },
          {
            "name": "等比通项与求和",
            "formula": "$a_n=a_1 q^{n-1},\\;S_n=\\dfrac{a_1(1-q^n)}{1-q}\\;(q\\ne 1)$"
          },
          {
            "name": "通项与前 $n$ 项和",
            "formula": "$a_1=S_1,\\;a_n=S_n-S_{n-1}\\;(n\\ge 2)$"
          },
          {
            "name": "导数定义与切线",
            "formula": "$f'(x_0)=\\lim_{h\\to 0}\\dfrac{f(x_0+h)-f(x_0)}{h},\\;y-y_0=f'(x_0)(x-x_0)$"
          },
          {
            "name": "常用导数",
            "formula": "$(x^n)'=nx^{n-1},\\;(e^x)'=e^x,\\;(\\ln x)'=\\dfrac{1}{x},\\;(\\sin x)'=\\cos x,\\;(\\cos x)'=-\\sin x$"
          },
          {
            "name": "牛顿-莱布尼茨",
            "formula": "$\\int_a^b f(x)\\,dx=F(b)-F(a)$",
            "note": "拓展内容，不代表现行必修范围；$f$ 在 $[a,b]$ 连续，$F$ 为其原函数。"
          }
        ]
      },
      {
        "title": "计数与概率",
        "items": [
          {
            "name": "排列组合",
            "formula": "$A_n^k=\\dfrac{n!}{(n-k)!},\\;C_n^k=\\dfrac{n!}{k!(n-k)!}$"
          },
          {
            "name": "二项式定理",
            "formula": "$(a+b)^n=\\sum_{k=0}^n C_n^k a^{n-k}b^k$"
          },
          {
            "name": "二项分布",
            "formula": "$P(X=k)=C_n^k p^k(1-p)^{n-k},\\;E(X)=np,\\;D(X)=np(1-p)$"
          },
          {
            "name": "期望与方差",
            "formula": "$E(X)=\\sum x_ip_i,\\;D(X)=E(X^2)-[E(X)]^2$"
          },
          {
            "name": "独立性检验",
            "formula": "$K^2=\\dfrac{n(ad-bc)^2}{(a+b)(c+d)(a+c)(b+d)}$"
          }
        ]
      },
      {
        "title": "立体几何",
        "items": [
          {
            "name": "锥体与球体体积",
            "formula": "$V_{\\text{锥}}=\\dfrac{1}{3}Sh,\\;V_{\\text{球}}=\\dfrac{4}{3}\\pi R^3,\\;S_{\\text{球}}=4\\pi R^2$"
          },
          {
            "name": "线面角",
            "formula": "$\\sin\\theta=\\dfrac{|\\vec u\\cdot\\vec n|}{|\\vec u||\\vec n|}$"
          },
          {
            "name": "点面距离",
            "formula": "$d=\\dfrac{|\\overrightarrow{PA}\\cdot\\vec n|}{|\\vec n|}$"
          }
        ]
      }
    ]
  },
  "physics": {
    "name": "物理",
    "sections": [
      {
        "title": "力学",
        "items": [
          {
            "name": "匀变速直线运动",
            "formula": "$v=v_0+at,\\;x=v_0t+\\dfrac{1}{2}at^2,\\;v^2-v_0^2=2ax$"
          },
          {
            "name": "牛顿第二定律",
            "formula": "$\\vec F_{合}=m\\vec a$",
            "note": "对惯性系；$F$ 是合力。"
          },
          {
            "name": "动量定理与守恒",
            "formula": "$\\vec F_{合}\\Delta t=\\Delta\\vec p$；系统合外力为零时 $\\sum\\vec p$ 守恒。"
          },
          {
            "name": "动能定理",
            "formula": "$W_{合}=E_{k2}-E_{k1}$"
          },
          {
            "name": "机械能守恒",
            "formula": "$E_k+E_p=$ 常量",
            "note": "只有重力（或弹力）做功时。"
          },
          {
            "name": "万有引力",
            "formula": "$F=G\\dfrac{m_1m_2}{r^2},\\;\\dfrac{GMm}{r^2}=m\\dfrac{v^2}{r}=m\\omega^2 r$"
          },
          {
            "name": "向心加速度",
            "formula": "$a_n=\\dfrac{v^2}{r}=\\omega^2 r$"
          },
          {
            "name": "简谐运动",
            "formula": "$x=A\\cos(\\omega t+\\varphi),\\;T=2\\pi\\sqrt{\\dfrac{m}{k}}$（弹簧振子），$T=2\\pi\\sqrt{\\dfrac{l}{g}}$（单摆，小角度）"
          }
        ]
      },
      {
        "title": "电磁学",
        "items": [
          {
            "name": "库仑定律",
            "formula": "$F=k\\dfrac{q_1q_2}{r^2}$"
          },
          {
            "name": "电场强度与电势差",
            "formula": "$E=\\dfrac{F}{q},\\;U_{AB}=\\dfrac{W_{AB}}{q}$；匀强电场 $U=Ed$（沿场强方向）"
          },
          {
            "name": "电容",
            "formula": "$C=\\dfrac{Q}{U},\\;C=\\dfrac{\\varepsilon_r S}{4\\pi k d}$（平行板）"
          },
          {
            "name": "欧姆定律与电功率",
            "formula": "$I=\\dfrac{U}{R},\\;P=UI=I^2R=\\dfrac{U^2}{R}$"
          },
          {
            "name": "电阻定律",
            "formula": "$R=\\rho\\dfrac{l}{S}$"
          },
          {
            "name": "闭合电路",
            "formula": "$E=I(R+r),\\;U=E-Ir$"
          },
          {
            "name": "洛伦兹力与安培力",
            "formula": "$F=qvB\\sin\\theta,\\;F=BIl\\sin\\theta$"
          },
          {
            "name": "回旋半径与周期",
            "formula": "$r=\\dfrac{mv}{qB},\\;T=\\dfrac{2\\pi m}{qB}$"
          },
          {
            "name": "法拉第电磁感应",
            "formula": "$\\mathcal{E}=n\\dfrac{\\Delta\\Phi}{\\Delta t}$；动生 $\\mathcal{E}=B\\ell v$（垂直）"
          }
        ]
      },
      {
        "title": "热学、光学与近代物理",
        "items": [
          {
            "name": "理想气体状态方程",
            "formula": "$pV=nRT$（或 $pV=NkT$）"
          },
          {
            "name": "热力学第一定律",
            "formula": "$\\Delta U=Q+W$",
            "note": "注意做功正负的约定：以系统为对象时，外界对系统做功为正。教材表述要看符号约定。人教版常取 $W$ 为外界对系统做功。"
          },
          {
            "name": "折射定律",
            "formula": "$n_1\\sin\\theta_1=n_2\\sin\\theta_2,\\;n=\\dfrac{c}{v}$"
          },
          {
            "name": "光电效应",
            "formula": "$E_k=h\\nu-W_0,\\;W_0=h\\nu_0$"
          },
          {
            "name": "能级",
            "formula": "$h\\nu=E_m-E_n$"
          },
          {
            "name": "质能方程",
            "formula": "$\\Delta E=\\Delta m\\,c^2$"
          }
        ]
      }
    ]
  },
  "chemistry": {
    "name": "化学",
    "sections": [
      {
        "title": "基本量与气体",
        "items": [
          {
            "name": "物质的量",
            "formula": "$n=\\dfrac{m}{M}=\\dfrac{N}{N_A}=\\dfrac{V}{V_m}$（气体，标准状况下 $V_m=22.4\\,\\mathrm{L\\,mol^{-1}}$）"
          },
          {
            "name": "物质的量浓度",
            "formula": "$c=\\dfrac{n}{V}$"
          },
          {
            "name": "气体摩尔体积",
            "formula": "$V_m=\\dfrac{V}{n}$"
          }
        ]
      },
      {
        "title": "反应原理",
        "items": [
          {
            "name": "反应热与焓变",
            "formula": "$\\Delta H=\\sum \\Delta H_{\\mathrm{f}}(\\text{生成物})-\\sum \\Delta H_{\\mathrm{f}}(\\text{反应物})$",
            "note": "热化学方程式需注明状态与计量数。放热 $\\Delta H<0$。"
          },
          {
            "name": "平衡常数",
            "formula": "$K=\\dfrac{c^{\\nu}(\\text{生成物})}{c^{\\nu}(\\text{反应物})}$（对气体也可用分压 $K_p$）",
            "note": "纯固体、纯液体不写入 $K$。"
          },
          {
            "name": "转化率与平衡移动",
            "formula": "浓度、压强、温度对平衡的影响用勒夏特列原理判断；催化剂不影响平衡，只改速率。"
          },
          {
            "name": "水的离子积",
            "formula": "$K_w=c(\\mathrm{H}^+)\\,c(\\mathrm{OH}^-)=1.0\\times 10^{-14}\\;(25^\\circ\\mathrm{C})$"
          },
          {
            "name": "$\\mathrm{pH}$",
            "formula": "$\\mathrm{pH}=-\\lg c(\\mathrm{H}^+)$"
          },
          {
            "name": "弱电解质电离",
            "formula": "$K_a=\\dfrac{c(\\mathrm{H}^+)c(\\mathrm{A}^-)}{c(\\mathrm{HA})}$"
          }
        ]
      },
      {
        "title": "电化学与结构",
        "items": [
          {
            "name": "电池电动势（定性）",
            "formula": "负极氧化、正极还原；原电池中电子由负极经外电路到正极。"
          },
          {
            "name": "电解规律",
            "formula": "阳极阴离子放电顺序，阴极阳离子放电顺序，需结合具体离子与电极材料。"
          },
          {
            "name": "电子式与杂化（选必）",
            "formula": "价层电子对互斥判断构型；$\\sigma$ 与 $\\pi$ 键。"
          }
        ]
      }
    ]
  },
  "biology": {
    "name": "生物学",
    "sections": [
      {
        "title": "分子与细胞",
        "items": [
          {
            "name": "蛋白质与核酸",
            "formula": "氨基酸脱水缩合：肽键数 $=$ 氨基酸数 $-$ 肽链数；核酸中 $\\mathrm{A}$ 与 $\\mathrm{T}$（或 $\\mathrm{U}$）、$\\mathrm{G}$ 与 $\\mathrm{C}$ 配对。"
          },
          {
            "name": "酶与 ATP",
            "formula": "酶降低活化能；ATP 与 ADP 相互转化，$\\mathrm{ATP}\\rightleftharpoons\\mathrm{ADP}+\\mathrm{P_i}+$ 能量。"
          },
          {
            "name": "光合作用",
            "formula": "总反应：$6\\mathrm{CO_2}+12\\mathrm{H_2O}\\xrightarrow{光、叶绿体}\\mathrm{C_6H_{12}O_6}+6\\mathrm{O_2}+6\\mathrm{H_2O}$",
            "note": "光反应在类囊体薄膜，暗反应（卡尔文循环）在叶绿体基质。"
          },
          {
            "name": "有氧呼吸",
            "formula": "$\\mathrm{C_6H_{12}O_6}+6\\mathrm{O_2}+6\\mathrm{H_2O}\\rightarrow 6\\mathrm{CO_2}+12\\mathrm{H_2O}+$ 能量",
            "note": "三个阶段场所：细胞质基质、线粒体基质、线粒体内膜。"
          }
        ]
      },
      {
        "title": "遗传与进化",
        "items": [
          {
            "name": "分离定律",
            "formula": "杂合子自交后代性状分离比 $3:1$（完全显性、且统计数量足够）。测交比 $1:1$。"
          },
          {
            "name": "自由组合定律",
            "formula": "两对独立遗传的等位基因，杂合子自交 $9:3:3:1$。"
          },
          {
            "name": "哈迪-温伯格（了解）",
            "formula": "$p^2+2pq+q^2=1,\\;p+q=1$",
            "note": "理想种群中基因频率不变。"
          }
        ]
      },
      {
        "title": "稳态与生态",
        "items": [
          {
            "name": "血糖调节",
            "formula": "胰岛素降血糖，胰高血糖素升血糖，二者拮抗。"
          },
          {
            "name": "神经冲动",
            "formula": "静息电位内负外正，动作电位内正外负；兴奋在突触处单向传递。"
          },
          {
            "name": "能量流动",
            "formula": "相邻营养级间能量传递效率约 $10\\%\\sim 20\\%$；能量单向流动、逐级递减。"
          }
        ]
      }
    ]
  }
}
